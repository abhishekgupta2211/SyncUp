# LoveChat environment configuration
# Copy this file to `.env` and fill in your Supabase project values.
# Get these from: Supabase Dashboard → Project Settings → API

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# ZegoCloud (voice/video calls) — from https://console.zegocloud.com
# Project → choose "Call Kit (zego_uikit_prebuilt_call)" → copy AppID + AppSign
ZEGO_APP_ID=0
ZEGO_APP_SIGN=YOUR_APP_SIGN
